{
  "openapi": "3.1.0",
  "info": {
    "title": "Lodestar API",
    "description": "Lodestar REST API (ADR-0006).",
    "version": "1"
  },
  "paths": {
    "/api/v1/people": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "Lists People, ordered by ID unless `sort` is given.",
        "operationId": "list_people",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1–1000.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50,
              "maximum": 1000,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "display_name"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonPage"
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "people"
        ],
        "summary": "Creates a Person. Allowed without a session, so the first Person can be\ncreated; they then become their own Acting Person.",
        "operationId": "create_person",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Person"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "headers": {
              "etag": {
                "schema": {
                  "type": "string"
                }
              },
              "location": {
                "schema": {
                  "type": "string"
                }
              },
              "set-cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Set when there was no session"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            }
          },
          "422": {
            "description": "Invalid Person",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/people/{id}": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "Fetches a Person.",
        "operationId": "get_person",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "headers": {
              "etag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "people"
        ],
        "summary": "Replaces a Person. Needs a session and `If-Match`.",
        "operationId": "update_person",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "if-match",
            "in": "header",
            "description": "ETag of the version being changed",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Person"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "headers": {
              "etag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "412": {
            "description": "Out of date",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid Person",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "428": {
            "description": "If-Match missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Returns the current Acting Person.",
        "operationId": "get_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Sets the Acting Person, in a signed session cookie. Needs no session.",
        "operationId": "create_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "headers": {
              "set-cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "The session cookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "422": {
            "description": "No such Person",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewSession": {
        "type": "object",
        "description": "Chooses the Acting Person.",
        "required": [
          "person_id"
        ],
        "properties": {
          "person_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "Person": {
        "type": "object",
        "description": "A Person. Also the request body for `POST` and `PUT`: read-only fields may\nbe sent only if they match what is stored.",
        "required": [
          "id",
          "display_name",
          "version"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "description": "Required, 1–100 characters; surrounding whitespace is trimmed.",
            "maxLength": 100,
            "minLength": 1
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "readOnly": true,
            "minimum": 1
          }
        }
      },
      "PersonPage": {
        "type": "object",
        "description": "A page of People.",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Matching People across all pages.",
            "minimum": 0
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An RFC 9457 problem details object, served as `application/problem+json`.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Always `about:blank`: the status code says what went wrong."
          }
        }
      },
      "Session": {
        "type": "object",
        "description": "The current Acting Person.",
        "required": [
          "person"
        ],
        "properties": {
          "person": {
            "$ref": "#/components/schemas/Person"
          }
        }
      }
    }
  }
}
