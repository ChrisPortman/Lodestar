{
  "db_name": "SQLite",
  "query": "SELECT a.id, a.project_id, p.project_code, a.reference, a.description,\n                      a.assignee_id, pe.display_name AS \"assignee_name?\", a.due_date,\n                      a.closed, a.version\n               FROM actions a\n               JOIN projects p ON p.id = a.project_id\n               LEFT JOIN people pe ON pe.id = a.assignee_id\n               WHERE (?1 IS NULL OR a.project_id = ?1) AND (?2 OR a.closed = 0)\n               ORDER BY p.project_code, a.reference, a.id LIMIT ?3 OFFSET ?4",
