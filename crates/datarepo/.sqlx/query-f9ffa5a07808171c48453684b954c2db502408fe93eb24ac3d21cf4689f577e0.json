  "query": "SELECT m.id, m.project_id, m.leader_id, p.display_name AS leader_name,\n                      m.started_at, m.ended_at, m.version\n               FROM meetings m JOIN people p ON p.id = m.leader_id\n               WHERE m.project_id = ?\n               ORDER BY m.started_at DESC, m.id DESC\n               LIMIT ? OFFSET ?",
